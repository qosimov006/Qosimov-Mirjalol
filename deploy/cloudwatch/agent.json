{
  "agent": {"metrics_collection_interval": 60, "run_as_user": "root"},
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {"InstanceId": "${aws:InstanceId}"},
    "metrics_collected": {
      "mem":  {"measurement": ["mem_used_percent"]},
      "disk": {"measurement": ["used_percent"], "resources": ["/"]}
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/bts-express/app.log", "log_group_name": "/bts-express/app", "log_stream_name": "{instance_id}", "retention_in_days": 14},
          {"file_path": "/var/log/nginx/access.log", "log_group_name": "/bts-express/nginx-access", "log_stream_name": "{instance_id}", "retention_in_days": 14}
        ]
      }
    }
  }
}
