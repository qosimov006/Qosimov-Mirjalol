# Nusxa oling:  cp deploy/config.env.example deploy/config.env   (config.env .gitignore'da; unga PAROL YOZMANG)
# Bu faylda faqat maxfiy bo'lmagan sozlamalar turadi.
AWS_REGION=eu-central-1            # o'zingizga yaqin region
PROJECT=bts-express
# S3 bucket nomi butun AWS bo'yicha noyob bo'lishi kerak: oxiriga o'zingizning familiyangiz/raqam qo'shing
S3_BUCKET=bts-express-CHANGE-ME-12345
EC2_TYPE=t3.micro                  # Free Tier / arzon. Katta tur olmang (xarajat!)
DB_CLASS=db.t4g.micro              # RDS eng arzon turi (Free Tier akkauntda db.t3.micro ham mumkin)
DB_STORAGE_GB=20
ALERT_EMAIL=you@example.com        # CloudWatch ogohlantirishlari shu emailga keladi
BUDGET_USD=5                       # oylik byudjet signali
# SSH uchun faqat O'ZINGIZNING IP manzilingiz (https://checkip.amazonaws.com). Bo'sh qoldirsangiz 22-port umuman ochilmaydi
# va EC2'ga AWS Systems Manager Session Manager orqali (brauzerdan) kirasiz - bu xavfsizroq.
SSH_CIDR=
# Domen bo'lsa HTTPS sertifikat olinadi (Let's Encrypt). Bo'sh bo'lsa faqat HTTP.
DOMAIN=
